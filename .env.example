# --- Dashboard ---
ADMIN_PASSWORD=change-me
# Staff logins: Name:password pairs, comma separated, each password different (e.g. Rina:pass1,Karim:pass2)
STAFF=

# --- LLM: bedrock (default), anthropic, or ollama (local, no cloud account) ---
LLM_PROVIDER=bedrock
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Some regions need an inference-profile prefix, e.g. us.anthropic.claude-opus-5-5
BEDROCK_MODEL_ID=anthropic.claude-opus-5-5
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Anthropic API only: low | medium | high
LLM_EFFORT=low
# Local model via Ollama (needs a model with tool support)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_NUM_CTX=8192

# --- WhatsApp Cloud API ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=pick-any-random-string
WHATSAPP_APP_SECRET=
GRAPH_API_VERSION=v21.0

# --- Facebook Messenger + Instagram DMs (same Meta app: reuses WHATSAPP_APP_SECRET and WHATSAPP_VERIFY_TOKEN) ---
# Webhook URL: https://<your server>/messenger/webhook. The Instagram account must be linked to the Facebook Page.
PAGE_ACCESS_TOKEN=
# Public address of this server; Messenger/Instagram download product photos from it
PUBLIC_URL=

# --- Voice notes ---
# Speech-to-text provider: openai | aws
STT_PROVIDER=openai
# Transcripts below this confidence (0-1) get a "please repeat" reply
STT_MIN_CONFIDENCE=0.5
OPENAI_API_KEY=
OPENAI_STT_MODEL=whisper-1
# Needed for STT_PROVIDER=aws (Amazon Transcribe batch jobs read audio from S3)
TRANSCRIBE_S3_BUCKET=
# Also reply with a voice note when the customer sent one (OpenAI TTS)
VOICE_REPLY=false
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=coral

# --- Owner alerts: email when a chat needs a human (leave ALERT_EMAIL empty to turn off) ---
# Gmail: SMTP_USER is your address, SMTP_PASSWORD an app password (myaccount.google.com/apppasswords)
ALERT_EMAIL=
SMTP_USER=
SMTP_PASSWORD=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587

# --- Optional overrides ---
# BUSINESS_FILE=../business.yaml
# DATABASE_URL=sqlite:///backend/shop.db
# MEDIA_DIR=backend/media
