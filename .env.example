# --- The first business ---
# seed.py (and Docker's first start) creates it from business.yaml and these when the database has no businesses.
# Staff sign in with the business ID and their own password. Add more businesses and staff with manage.py.
SHOP_ID=nakshi
# The owner's password: at least 8 characters, and not "admin" or "change-me"
ADMIN_PASSWORD=change-me
# More staff: Name:password pairs, comma separated, each password different (e.g. Rina:pass-one,Karim:pass-two)
STAFF=

# --- LLM: bedrock (default), anthropic, or ollama (local, no cloud account) ---
LLM_PROVIDER=bedrock
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Some regions need an inference-profile prefix, e.g. us.anthropic.claude-opus-5-5
BEDROCK_MODEL_ID=anthropic.claude-opus-5-5
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Anthropic API only: low | medium | high
LLM_EFFORT=low
# Local model via Ollama (needs a model with tool support)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_NUM_CTX=8192

# --- Meta app (one for every café): verifies and signs the webhooks ---
WHATSAPP_VERIFY_TOKEN=pick-any-random-string
WHATSAPP_APP_SECRET=
GRAPH_API_VERSION=v21.0

# --- The first café's WhatsApp number and Facebook Page (later cafés: python manage.py connect) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Messenger + Instagram DMs. Webhook URL: https://<your server>/messenger/webhook. The Instagram account must be linked to the Page.
PAGE_ACCESS_TOKEN=
PAGE_ID=
INSTAGRAM_ID=
# Public address of this server; Messenger/Instagram download menu photos from it
PUBLIC_URL=
# Docker only: your domain (cafe.example.com) for automatic HTTPS. Empty = plain HTTP on port 80, for local use.
SITE_ADDRESS=
# Docker only: other ports when 80/443 are taken on this machine (then open http://localhost:8080)
# HTTP_PORT=8080
# HTTPS_PORT=8443

# --- Voice notes ---
# Speech-to-text provider: openai | aws
STT_PROVIDER=openai
# Transcripts below this confidence (0-1) get a "please repeat" reply
STT_MIN_CONFIDENCE=0.5
OPENAI_API_KEY=
OPENAI_STT_MODEL=whisper-1
# Needed for STT_PROVIDER=aws (Amazon Transcribe batch jobs read audio from S3)
TRANSCRIBE_S3_BUCKET=
TRANSCRIBE_LANGUAGE=en-US
# Also reply with a voice note when the customer sent one (OpenAI TTS)
VOICE_REPLY=false
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=coral

# --- Owner alerts: email when a chat needs a person or a request needs approval (leave empty to turn off) ---
# A café's alert_email in its business.yaml overrides ALERT_EMAIL.
# Gmail: SMTP_USER is your address, SMTP_PASSWORD an app password (myaccount.google.com/apppasswords)
ALERT_EMAIL=
SMTP_USER=
SMTP_PASSWORD=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587

# --- Optional overrides ---
# BUSINESS_FILE=../business.yaml
# DATABASE_URL=sqlite:///backend/shop.db
# MEDIA_DIR=backend/media
